{
  "name": "egroup-outing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:audio": "tsc -p tests/tsconfig.audio.json && node --test tests/opening-audio.test.mjs tests/opening-history.test.mjs",
    "test:votes": "tsc -p tests/tsconfig.votes.json && node --test tests/vote-details.test.mjs",
    "test:draw": "tsc -p tests/tsconfig.draw.json && node --test tests/light-draw.test.mjs",
    "test:summary": "tsc -p tests/tsconfig.summary.json && node --test tests/vote-summary.test.mjs tests/calendar.test.mjs tests/vote-countdown.test.mjs",
    "test:score": "tsc -p tests/tsconfig.score.json && node --test tests/score-motion.test.mjs",
    "test:admin": "tsc -p tests/tsconfig.admin.json && node --test tests/voting-access.test.mjs tests/catalog-impact.test.mjs tests/catalog-order.test.mjs tests/text-highlights.test.mjs tests/catalog-upgrade.test.mjs",
    "test:images": "tsc -p tests/tsconfig.images.json && node --test tests/image-viewport.test.mjs",
    "test:stores": "tsc -p tests/tsconfig.stores.json && node --test tests/store-directory.test.mjs",
    "reviews:refresh": "tsc -p scripts/tsconfig.reviews.json && node .tools/review-job/scripts/refresh-store-reviews.js"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@sparticuz/chromium": "153.0.0",
    "firebase": "12.19.0",
    "next": "16.3.5",
    "playwright-core": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "firebase-admin": "14.5.0",
    "typescript": "7.0.2"
  }
}
