      { "author": "宥宥", "authorUrl": "https://www.google.com/maps/contrib/102660750875263430226/reviews?hl=zh-Hant-TW", "rating": 5, "relativeTimeAtCapture": "5 天前", "text": "★★★★★第一次來六度空間，整體體驗比想像中還要好！環境很舒服、氣氛也很放鬆，店員服務親切，有問題都很有耐心地介紹和協助。整體空間乾淨又有質感，讓人會想再來。這次的體驗很滿意，推薦給想找個地方放鬆、跟朋友一起玩的大家～下次還會再來！" },
      { "author": "小熊", "authorUrl": "https://www.google.com/maps/contrib/108348979354568117474/reviews?hl=zh-Hant-TW", "rating": 5, "relativeTimeAtCapture": "1 週前", "text": "超好玩" },
      { "author": "黃文俊", "authorUrl": "https://www.google.com/maps/contrib/118274310891621105923/reviews?hl=zh-Hant-TW", "rating": 3, "relativeTimeAtCapture": "2 週前", "text": "難得的公司辦活動，一起在六度空間玩雷射槍遊戲，蠻不錯的，緊張刺激，很好玩，促進團隊成員參與活動，增進彼此互相交流的感覺" },
      { "author": "劉任", "authorUrl": "https://www.google.com/maps/contrib/111669443346143352186/reviews?hl=zh-Hant-TW", "rating": 5, "relativeTimeAtCapture": "2 週前", "text": "超好玩！超推團戰" },
